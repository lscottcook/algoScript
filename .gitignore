# Build output — regenerated by `dotnet build` on every machine.
# These were committed previously and are the reason `git pull` aborted on the
# VPS: the VPS builds locally, so its own obj/ files collide with the tracked
# copies coming down from origin.
[Bb]in/
[Oo]bj/

# Visual Studio per-machine state (.suo is binary user settings, .vsidx is a
# local content index) — never the same on two machines, conflicts constantly.
.vs/
*.user
*.suo

# Local trade logs
*.csv
